<?xml version="1.0" encoding="utf-8"?>
<!-- 4.4.0: ONE fixed page — no ScrollView, by Majid's order. The
     status card carries layout_weight so it absorbs all slack; only
     connect essentials live here. Everything else is behind the gear
     (Settings). Verified to fit 1080x2280 in fa and en, all states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- header: centered title block + gear at the end -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="#EAF1FF"
                android:textSize="27sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_subtitle"
                android:textColor="#8FA3CC"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/gearBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#B9C8E8"
            android:textSize="22sp" />
    </FrameLayout>

    <!-- connection card: state at a glance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/statusDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:textColor="#DCE7FA"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- hero: the Design 2 fox (OrbView) — it only ever moves
             by gentle transforms of the same still, per Majid's
             word; the fox itself never changes. -->
        <com.fpn.tunnel.OrbView
            android:id="@+id/orbView"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center_horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/exitInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#8FA3CC"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/faHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/fa_hint"
            android:textColor="#FFD479"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/pill_btn"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- location -->
    <TextView
        style="@style/SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/section_location" />

    <Spinner
        android:id="@+id/countrySpinner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/seg_wrap" />

    <!-- account quick-switch -->
    <Button
        android:id="@+id/acctBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_ghost"
        android:textAllCaps="false"
        android:textColor="#DCE7FA"
        android:textSize="14.5sp" />

    <TextView
        android:id="@+id/footerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#5F7396"
        android:textSize="11.5sp" />
</LinearLayout>
